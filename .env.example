# 复制为 .env 后按需填写。编码 Harness 的模型与原生登录由 Harness 管理。
# 例外：BYOK 在界面配置服务商 / Key，由团团直接调用模型；无需在这里填写模型 Key。
PORT=8787
# 默认只监听本机回环；改监听地址不会放宽 Host / Origin 检查，也不会启用远程鉴权
TUANTUAN_HOST=127.0.0.1
# 数据库文件路径（项目改名为团团后文件名保持不变，兼容旧数据）
DB_PATH=data/agent-hub.db
# 设为 1 时在 Harness 列表里显示内置的 mock ACP agent（仅用于测试 / 演示，不需要安装任何 CLI）
TUANTUAN_MOCK_HARNESS=

# Root for auto-created conversation folders (default ~/Tuantuan)
# TUANTUAN_WORKSPACES=~/Tuantuan
