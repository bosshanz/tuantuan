# 复制为 .env 后按需填写；不配置 config/providers.json 时全部走内置 mock，无需任何 Key。
PORT=8787
# 数据库文件路径
DB_PATH=data/agent-hub.db
# Skills 目录（每个子目录一个 SKILL.md）
SKILLS_DIR=skills
# Provider/路由配置文件，参考 config/providers.example.json
AGENT_HUB_CONFIG=config/providers.json
# mock 每个流式分片的延迟（毫秒）
MOCK_CHUNK_DELAY_MS=15

# ---- 启用的真实模型（1–5 个，逗号分隔，格式 provider/模型名）----
# provider 可选 newapi / deepseek / qwen / doubao；留空且没有 providers.json 时使用内置 mock。
# 内置目录已知：deepseek-chat deepseek-reasoner qwen-turbo qwen-plus qwen-max qwen-long qwen-vl-plus
#               doubao-seed-1-6-250615 doubao-seed-1-6-flash-250615
AGENT_HUB_MODELS=
# 不在目录里的模型（如 newapi/gpt-4o）按序号补元数据，序号从 1 开始：
# AGENT_HUB_MODEL_1_TAGS=chat,coding,vision      # chat|coding|reasoning|long_context|tool_heavy|vision
# AGENT_HUB_MODEL_1_TIER=3                       # 成本档 1 便宜 ~ 3 最强
# AGENT_HUB_MODEL_1_CONTEXT=128000
# 可选：用其中一个模型做 LLM 分类器（必须在 AGENT_HUB_MODELS 中）
AGENT_HUB_CLASSIFIER_MODEL=

# ---- 百炼决策模型（Auto 路由分类器，可选）----
# 填业务空间地址即启用，例如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DECISION_BASE_URL=
# 留空则使用 DASHSCOPE_API_KEY
DECISION_API_KEY=
DECISION_MODEL=decision-model-preview
DECISION_MIN_CONFIDENCE=0.6
DECISION_TIMEOUT_MS=3000

# ---- 真实 Provider（AGENT_HUB_MODELS 用到的 provider 必须填 Key）----
# *_BASE_URL 留空则使用官方默认地址；填写则覆盖。
# *_API_KEY 的名字与配置文件中的 apiKeyEnv 对应。

# NewAPI / OneAPI 等中转：没有默认地址，示例配置里启用了它，必须填写 BASE_URL（或从 providers.json 删掉 newapi）
NEWAPI_BASE_URL=
NEWAPI_API_KEY=

# DeepSeek（默认 https://api.deepseek.com/v1）
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=

# 通义千问 DashScope 兼容模式（默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=

# 豆包 火山方舟（默认 https://ark.cn-beijing.volces.com/api/v3）
ARK_BASE_URL=
ARK_API_KEY=
