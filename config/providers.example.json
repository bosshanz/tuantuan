{
  "providers": [
    {
      "id": "mock",
      "type": "mock"
    },
    {
      "id": "newapi",
      "type": "openai",
      "baseUrlEnv": "NEWAPI_BASE_URL",
      "apiKeyEnv": "NEWAPI_API_KEY"
    },
    {
      "id": "deepseek",
      "type": "openai",
      "baseUrlEnv": "DEEPSEEK_BASE_URL",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    {
      "id": "qwen",
      "type": "openai",
      "baseUrlEnv": "DASHSCOPE_BASE_URL",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "DASHSCOPE_API_KEY"
    },
    {
      "id": "doubao",
      "type": "openai",
      "baseUrlEnv": "ARK_BASE_URL",
      "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
      "apiKeyEnv": "ARK_API_KEY"
    }
  ],
  "models": [
    {
      "id": "qwen/qwen-turbo",
      "provider": "qwen",
      "model": "qwen-turbo",
      "tags": ["chat", "tool_heavy"],
      "costTier": 1,
      "contextWindow": 128000
    },
    {
      "id": "deepseek/deepseek-chat",
      "provider": "deepseek",
      "model": "deepseek-chat",
      "tags": ["chat", "coding", "tool_heavy"],
      "costTier": 2,
      "contextWindow": 64000
    },
    {
      "id": "deepseek/deepseek-reasoner",
      "provider": "deepseek",
      "model": "deepseek-reasoner",
      "tags": ["reasoning", "coding"],
      "costTier": 3,
      "contextWindow": 64000
    },
    {
      "id": "qwen/qwen-long",
      "provider": "qwen",
      "model": "qwen-long",
      "tags": ["long_context", "chat"],
      "costTier": 2,
      "contextWindow": 1000000
    },
    {
      "id": "doubao/doubao-seed-1-6",
      "provider": "doubao",
      "model": "doubao-seed-1-6-250615",
      "tags": ["chat", "coding", "reasoning", "vision", "tool_heavy"],
      "costTier": 3,
      "contextWindow": 256000
    },
    {
      "id": "mock/small",
      "provider": "mock",
      "model": "small",
      "tags": ["chat"],
      "costTier": 1,
      "contextWindow": 8000
    }
  ],
  "router": {
    "classifierModel": "qwen/qwen-turbo",
    "minTier": {
      "easy": 1,
      "medium": 2,
      "hard": 3
    }
  },
  "limits": {
    "maxAgentHops": 5,
    "maxToolIterations": 6,
    "contextMessages": 30,
    "contextChars": 24000
  }
}
