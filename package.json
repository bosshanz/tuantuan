{
  "name": "tuantuan",
  "description": "团团 Tuantuan — 多 Agent 群聊工作台：编码 Agent（ACP Harness）群聊、任务交接",
  "repository": {
    "type": "git",
    "url": "https://github.com/bosshanz/tuantuan.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests/",
    "e2e": "bun scripts/e2e-smoke.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "desktop:install": "cd desktop && bun install && node node_modules/electron/install.js",
    "desktop:dev": "bun run build && cd desktop && bun run dev",
    "desktop:build": "bun run build && bun desktop/scripts/dist.ts",
    "desktop:smoke": "bun desktop/scripts/smoke.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.90.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "^1.8.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
